<!DOCTYPE html>
<html>
<head>
    <title><%= __('admin.collectionDetail.manageCollection', { name: collection.name }) %></title>
    <link rel="stylesheet" href="<%= assetUrl('/resources/admin-base.css') %>">
    <link rel="stylesheet" href="<%= assetUrl('/resources/admin-collection-detail.css') %>">
    <meta name="csrf-token" content="<%= csrfToken %>">
</head>
<body>
    <div class="container" id="collection-detail-page" data-collection-id="<%= collection.id %>" data-display-type="<%= collection.display_type || 'single' %>">
        <% const totalMediaCount = media.length; %>
        <% const imageCount = media.filter((m) => !m.isVideo).length; %>
        <% const videoCount = media.filter((m) => !!m.isVideo).length; %>
        <% const reportedCount = media.filter((m) => typeof m.report_markdown === 'string' && m.report_markdown.trim()).length; %>
        <% const unpublishedCount = media.filter((m) => !m.is_published || (m.report_markdown || '') !== (m.published_report_markdown || '')).length; %>
        <% const shouldCollapseBlocks = (collection.display_type === 'anthology' || collection.display_type === 'archiving'); %>
        <% const hasPendingDraftChanges = ((collection.report_markdown || '') !== (collection.published_report_markdown || '') || media.some((m) => !m.is_published || !!m.is_deleted_draft || (m.report_markdown || '') !== (m.published_report_markdown || '') || Number(m.order_index || 0) !== Number(m.published_order_index || 0)) || blocks.some((b) => !b.is_published || !!b.is_deleted_draft || (b.markdown || '') !== (b.published_markdown || '') || (b.media_ids || '[]') !== (b.published_media_ids || '[]') || Number(b.order_index || 0) !== Number(b.published_order_index || 0))); %>
        <div class="page-header">
            <div>
                <a href="/admin" class="btn-link"><%= __('admin.settings.backToDashboard') %></a>
                <h1 style="margin-top: 1rem;"><%= __('admin.collectionDetail.manageCollection', { name: collection.name }) %></h1>
                <p class="page-subtitle"><%= __('admin.collectionDetail.collectionContentManagement') %></p>
            </div>
            <div class="stat-row">
                <span class="stat-pill"><%= __('admin.collectionDetail.totalMedia') %> <strong><%= totalMediaCount %></strong></span>
                <span class="stat-pill"><%= __('admin.collectionDetail.images') %> <strong><%= imageCount %></strong></span>
                <span class="stat-pill"><%= __('admin.collectionDetail.videos') %> <strong><%= videoCount %></strong></span>
                <span class="stat-pill"><%= __('admin.collectionDetail.pendingPublish') %> <strong id="unpublished-count"><%= unpublishedCount %></strong></span>
                <span class="stat-pill"><%= __('admin.collectionDetail.reportedCount') %> <strong id="reported-count"><%= reportedCount %></strong></span>
            </div>
        </div>
        <div id="page-notice" class="page-notice" role="status" aria-live="polite"></div>

        <div id="block-list" class="block-list">
        <% blocks.forEach(function(block) { %>
            <% if (block.block_type === 'media') { %>
                <div class="section block-card block-card-media<%= shouldCollapseBlocks ? ' is-collapsed' : '' %>" data-block-id="<%= block.id %>" data-block-type="media" data-is-published="<%= block.is_published ? '1' : '0' %>" data-published-media-ids="<%= block.published_media_ids || '[]' %>" draggable="true">
                    <div class="section-header">
                        <div class="block-card-header-left">
                            <span class="block-handle" title="<%= __('admin.collectionDetail.dragToReorder') %>">⠿</span>
                            <div>
                                <h2><%= __('admin.collectionDetail.mediaManagement') %><% if (block.title) { %><span class="block-card-title-preview"> · <%= block.title %></span><% } %></h2>
                                <p class="section-subtitle"><%= __('admin.collectionDetail.mediaManagementHint') %></p>
                            </div>
                        </div>
                        <div class="block-card-header-right">
                            <button type="button" class="btn-toggle-collapse" data-block-id="<%= block.id %>" title="<%= __('admin.collectionDetail.collapseBlock') %>">
                                <span class="collapse-icon-open">▾</span><span class="collapse-label-open"><%= __('admin.collectionDetail.collapseBlock') %></span>
                                <span class="collapse-icon-closed">▸</span><span class="collapse-label-closed"><%= __('admin.collectionDetail.expandBlock') %></span>
                            </button>
                            <span class="block-move-group">
                                <button type="button" class="btn-block-move btn-block-up" data-block-id="<%= block.id %>" title="<%= __('admin.collectionDetail.moveUp') %>"><%= __('admin.collectionDetail.moveUp') %></button>
                                <button type="button" class="btn-block-move btn-block-down" data-block-id="<%= block.id %>" title="<%= __('admin.collectionDetail.moveDown') %>"><%= __('admin.collectionDetail.moveDown') %></button>
                            </span>
                            <button type="button" class="btn-delete-block" data-block-id="<%= block.id %>" title="<%= __('admin.collectionDetail.deleteBlock') %>"><%= __('admin.collectionDetail.deleteBlock') %></button>
                        </div>
                    </div>
                    <div class="block-card-body">
                        <% const isFormatEnabled = (collection.display_type === 'anthology' || collection.display_type === 'archiving'); %>
                        <%
                        const displayModeOptions = [
                            { value: 'single', label: __('admin.collectionDetail.formatSingle') },
                            { value: 'diptych', label: __('admin.collectionDetail.formatDiptych') },
                            { value: 'wall', label: __('admin.collectionDetail.formatWall') },
                            { value: 'report', label: __('admin.collectionDetail.formatReport') }
                        ];
                        const aspectRatioOptions = [
                            { value: '3:2', label: '3:2 (135)' },
                            { value: '2:3', label: '2:3 (Half)' },
                            { value: '2.7:1', label: '2.7:1 (X-Pan)' },
                            { value: '4:3', label: '4:3 (6x4.5)' },
                            { value: '1:1', label: '1:1 (6x6)' },
                            { value: '1.16:1', label: '1.16:1 (6x7)' },
                            { value: '1.37:1', label: '1.37:1 (6x8)' },
                            { value: '2.25:1', label: '2.25:1 (6x12)' },
                            { value: '3:1', label: '3:1 (6x17)' },
                            { value: '5:4', label: '5:4 (4x5)' }
                        ];
                        const fixedDisplayModeMap = {
                            'single': __('admin.collectionDetail.formatSingle'),
                            'diptych': __('admin.collectionDetail.formatDiptych'),
                            'wall': __('admin.collectionDetail.formatWall'),
                            'report': __('admin.collectionDetail.formatReport')
                        };
                        %>
                        <div class="media-config-panel">
                            <div class="media-config-row is-format-enabled">
                                <div class="media-config-field media-config-field-title">
                                    <label class="media-config-label" for="block-title-<%= block.id %>"><%= __('admin.collectionDetail.anthologyTitle') %></label>
                                    <div class="block-title-row" data-block-id="<%= block.id %>">
                                        <input type="text" id="block-title-<%= block.id %>" class="block-title-input" name="block_title" value="<%= block.title || '' %>" placeholder="<%= __('admin.collectionDetail.anthologyTitlePlaceholder') %>" maxlength="120" data-block-id="<%= block.id %>">
                                        <button type="button" class="btn-secondary btn-save-block-title" data-block-id="<%= block.id %>"><%= __('admin.collectionDetail.saveTitle') %></button>
                                        <span class="autosave-status block-title-status" data-block-id="<%= block.id %>" aria-live="polite"></span>
                                    </div>
                                </div>
                                <div class="media-config-field media-config-field-format">
                                    <label class="media-config-label" for="block-media-format-<%= block.id %>"><%= __('admin.collectionDetail.mediaFormat') %></label>
                                    <div class="block-format-row">
                                        <% if (isFormatEnabled) { %>
                                        <select id="block-media-format-<%= block.id %>" class="block-format-select" name="block_media_format" data-block-id="<%= block.id %>">
                                            <optgroup label="<%= __('admin.collectionDetail.displayMode') %>">
                                                <% displayModeOptions.forEach(function(opt) { %>
                                                    <option value="<%= opt.value %>" <%= block.media_format === opt.value ? 'selected' : '' %>><%= opt.label %></option>
                                                <% }); %>
                                            </optgroup>
                                            <optgroup label="<%= __('admin.collectionDetail.aspectRatio') %>">
                                                <% aspectRatioOptions.forEach(function(opt) { %>
                                                    <option value="<%= opt.value %>" <%= (block.media_format || '3:2') === opt.value ? 'selected' : '' %>><%= opt.label %></option>
                                                <% }); %>
                                            </optgroup>
                                        </select>
                                        <% } else { %>
                                        <select id="block-media-format-<%= block.id %>" class="block-format-select is-disabled" name="block_media_format" data-block-id="<%= block.id %>" disabled>
                                            <option value="<%= collection.display_type %>" selected><%= fixedDisplayModeMap[collection.display_type] || collection.display_type %></option>
                                        </select>
                                        <% } %>
                                        <span class="autosave-status block-format-status" data-block-id="<%= block.id %>" aria-live="polite"></span>
                                    </div>
                                </div>
                            </div>
                            <div class="media-config-label"><%= __('admin.collectionDetail.uploadMedia') %></div>
                            <form class="block-upload-form media-upload-row" action="/admin/collections/<%= collection.id %>/media/upload" method="POST" enctype="multipart/form-data" data-block-id="<%= block.id %>">
                                <div class="media-upload-controls">
                                    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                                    <input type="hidden" name="block_id" value="<%= block.id %>">
                                    <label class="file-select-label">
                                        <span><%= __('admin.collectionDetail.selectFile') %></span>
                                        <input type="file" name="media" accept="image/*,video/*,.mp4,.mov,.avi,.mkv,.webm,.m4v,.wmv,.flv" multiple required>
                                    </label>
                                    <span class="file-name-display" data-block-id="<%= block.id %>"></span>
                                    <button type="submit" class="btn-primary"><%= __('admin.collectionDetail.startUpload') %></button>
                                </div>
                            </form>
                            <div class="block-upload-progress" style="display:none;">
                                <div class="block-upload-progress-text"><%= __('admin.collectionDetail.preparingUpload') %></div>
                                <div class="block-upload-progress-track">
                                    <div class="block-upload-progress-bar" style="width:0%;"></div>
                                </div>
                            </div>
                        </div>
                        <% const blockMediaIds = JSON.parse(block.media_ids || '[]'); %>
                        <% const blockMediaItems = blockMediaIds.map(mid => media.find(m => m.id === mid)).filter(Boolean); %>
                        <div class="media-grid block-media-grid" data-block-id="<%= block.id %>">
                        <% blockMediaItems.forEach(function(m) { %>
                            <%- include('./partials/collection_detail/media-item', { media: m, collection, csrfToken }) %>
                        <% }); %>
                        </div>
                        <div class="media-order-bar">
                            <span class="media-order-hint"><%= __('admin.collectionDetail.orderMediaHint') %></span>
                            <div class="media-order-actions">
                                <span class="autosave-status block-order-status" data-block-id="<%= block.id %>" aria-live="polite"></span>
                                <button type="button" class="btn-primary btn-save-block-order" data-block-id="<%= block.id %>"><%= __('admin.collectionDetail.saveOrder') %></button>
                            </div>
                        </div>
                    </div>
                </div>
            <% } else { %>
                <div class="section block-card block-card-text<%= shouldCollapseBlocks ? ' is-collapsed' : '' %>" data-block-id="<%= block.id %>" data-block-type="text" data-is-published="<%= block.is_published ? '1' : '0' %>" draggable="true">
                    <div class="section-header">
                        <div class="block-card-header-left">
                            <span class="block-handle" title="<%= __('admin.collectionDetail.dragToReorder') %>">⠿</span>
                            <div>
                                <h2><%= __('admin.collectionDetail.artistStatement') %><% if (block.title) { %><span class="block-card-title-preview"> · <%= block.title %></span><% } %></h2>
                                <p class="section-subtitle"><%= __('admin.collectionDetail.reportPlaceholder') %></p>
                            </div>
                        </div>
                        <div class="block-card-header-right">
                            <button type="button" class="btn-toggle-collapse" data-block-id="<%= block.id %>" title="<%= __('admin.collectionDetail.collapseBlock') %>">
                                <span class="collapse-icon-open">▾</span><span class="collapse-label-open"><%= __('admin.collectionDetail.collapseBlock') %></span>
                                <span class="collapse-icon-closed">▸</span><span class="collapse-label-closed"><%= __('admin.collectionDetail.expandBlock') %></span>
                            </button>
                            <span class="block-move-group">
                                <button type="button" class="btn-block-move btn-block-up" data-block-id="<%= block.id %>" title="<%= __('admin.collectionDetail.moveUp') %>"><%= __('admin.collectionDetail.moveUp') %></button>
                                <button type="button" class="btn-block-move btn-block-down" data-block-id="<%= block.id %>" title="<%= __('admin.collectionDetail.moveDown') %>"><%= __('admin.collectionDetail.moveDown') %></button>
                            </span>
                            <button type="button" class="btn-delete-block" data-block-id="<%= block.id %>" title="<%= __('admin.collectionDetail.deleteBlock') %>"><%= __('admin.collectionDetail.deleteBlock') %></button>
                        </div>
                    </div>
                    <div class="block-card-body">
                        <div class="block-text-editor">
                            <div class="panel-soft">
                                <div class="block-title-row" data-block-id="<%= block.id %>">
                                    <input type="text" id="block-title-<%= block.id %>" class="block-title-input" name="block_title" value="<%= block.title || '' %>" placeholder="<%= __('admin.collectionDetail.documentTitlePlaceholder') %>" maxlength="120" data-block-id="<%= block.id %>">
                                    <button type="button" class="btn-secondary btn-save-block-title" data-block-id="<%= block.id %>"><%= __('admin.collectionDetail.saveTitle') %></button>
                                    <span class="autosave-status block-title-status" data-block-id="<%= block.id %>" aria-live="polite"></span>
                                </div>
                            </div>
                            <textarea name="markdown" placeholder="<%= __('admin.collectionDetail.reportPlaceholder') %>"><%= block.markdown || '' %></textarea>
                            <div class="block-text-actions">
                                <button type="button" class="btn-secondary media-library-upload-btn" data-target="block-<%= block.id %>"><%= __('admin.collectionDetail.uploadToDescription') %></button>
                                <button type="button" class="btn-primary btn-save-text-block" data-block-id="<%= block.id %>"><%= __('admin.collectionDetail.saveText') %></button>
                                <span class="autosave-status" data-role="block-save-status"></span>
                            </div>
                        </div>
                    </div>
                </div>
            <% } %>
        <% }); %>
        </div>

        <div class="block-add-bar">
            <button type="button" id="add-text-block" class="btn-add-block"><%= __('admin.collectionDetail.addTextBlock') %></button>
            <button type="button" id="add-media-block" class="btn-add-block"><%= __('admin.collectionDetail.addMediaBlock') %></button>
        </div>

        <%- include('./partials/collection_detail/draft-panel', { hasPendingDraftChanges }) %>
    </div>

    <script>window.__i18n = <%- JSON.stringify(__catalog) %>;</script>
    <script src="<%= assetUrl('/resources/js/admin-collection-detail.js') %>"></script>
    <script src="<%= assetUrl('/resources/js/admin-block-editor.js') %>"></script>
</body>
</html>
